{
  "name": "omer-akben",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true NODE_ENV=production next build",
    "size": "size-limit",
    "test": "NODE_OPTIONS=\"--no-warnings --localstorage-file=/tmp/vitest-localstorage\" vitest",
    "test:ui": "NODE_OPTIONS=\"--no-warnings --localstorage-file=/tmp/vitest-localstorage\" vitest --ui",
    "test:coverage": "NODE_OPTIONS=\"--no-warnings --localstorage-file=/tmp/vitest-localstorage\" vitest --coverage",
    "test:e2e": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test",
    "test:e2e:ui": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test --ui",
    "test:e2e:headed": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test --headed",
    "seed:assets": "node scripts/seed-assets.mjs",
    "generate:favicons": "tsx scripts/generate-shader-favicons.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/react": "^3.0.70",
    "@ai-sdk/xai": "3.0.46",
    "@mastra/ai-sdk": "1.0.3",
    "@mastra/core": "^1.1.0",
    "@mastra/memory": "^1.0.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/components": "1.0.6",
    "@react-email/render": "2.0.4",
    "@sentry/nextjs": "10.38.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "@upstash/vector": "^1.2.2",
    "@vercel/analytics": "^1.5.0",
    "ai": "^6.0.68",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "openai": "^6.5.0",
    "posthog-js": "1.336.4",
    "posthog-node": "5.24.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.9.1",
    "simple-icons": "^16.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.56.1",
    "@size-limit/preset-app": "^12.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.0.0",
    "png-to-ico": "^3.0.1",
    "size-limit": "^12.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
