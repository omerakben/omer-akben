{
  "name": "omer-akben",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "analyze": "ANALYZE=true NODE_ENV=production next build",
    "size": "size-limit",
    "test": "NODE_OPTIONS=\"--no-warnings\" vitest",
    "test:ui": "NODE_OPTIONS=\"--no-warnings\" vitest --ui",
    "test:coverage": "NODE_OPTIONS=\"--no-warnings\" vitest --coverage",
    "test:e2e": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test",
    "test:e2e:ui": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test --ui",
    "test:e2e:headed": "env -u NO_COLOR NODE_OPTIONS=\"--no-warnings\" playwright test --headed",
    "seed:assets": "node scripts/seed-assets.mjs",
    "generate:favicons": "tsx scripts/generate-shader-favicons.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@ai-sdk/xai": "3.0.83",
    "@mastra/ai-sdk": "1.4.0",
    "@mastra/core": "^1.25.0",
    "@mastra/memory": "^1.15.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.7",
    "@sentry/nextjs": "10.49.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@upstash/vector": "^1.2.3",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "posthog-js": "1.369.5",
    "posthog-node": "5.29.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.12.2",
    "simple-icons": "^16.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-app": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
